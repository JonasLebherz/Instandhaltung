# =====================================================================
# .env.example – Vorlage für die Zugangsdaten
#
# Lokal:  Datei nach ".env.local" kopieren und Werte eintragen.
# Vercel: Dieselben Namen unter Project → Settings → Environment Variables eintragen.
# Die echten Werte NIE auf GitHub hochladen (.env.local ist in .gitignore).
# =====================================================================

# Verbindung zur Datenbank (Supabase → Connect → "Transaction pooler", Port 6543).
# [YOUR-PASSWORD] durch das Datenbank-Passwort ersetzen.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Supabase-Projekt für das Login (Supabase → Project Settings → API).
# Der "anon"- bzw. "publishable"-Schlüssel darf öffentlich sein, er gibt keinen Datenzugriff.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Nur für lokale Tests ohne Supabase: Login abschalten.
# Auf Vercel NIEMALS setzen – sonst ist die Seite ohne Anmeldung erreichbar!
# LOGIN_DEAKTIVIERT=true
